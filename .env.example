# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Non-secret config (.env) — Safe to commit to version control
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

BETTER_AUTH_URL=http://localhost:3002

# Cloudflare Turnstile (public site key, safe for client-side)
VITE_TURNSTILE_SITE_KEY=<from Cloudflare Turnstile dashboard>

# VAPID public key (safe to commit - used in browser for push notifications)
# Generate with: bun run scripts/generate-vapid-jwk.ts
VITE_VAPID_PUBLIC_KEY=<base64url JWK public key>

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Secrets (.dev.vars for local, Wrangler secrets for production)
# ⚠️  NEVER commit these to version control!
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Better Auth
# BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>
# BETTER_AUTH_GOOGLE_CLIENT_ID=<from Google Cloud Console>
# BETTER_AUTH_GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
# BETTER_AUTH_TRUSTED_ORIGINS=<comma-separated production origins, optional>

# Cloudflare Turnstile
# TURNSTILE_SECRET_KEY=<from Cloudflare Turnstile dashboard>

# Unosend Email Service (for magic links)
# UNOSEND_API_KEY=<from https://app.unosend.co/api-keys>
# UNOSEND_FROM_EMAIL=noreply@yourdomain.com

# VAPID private key (⚠️ SECRET - for push notifications)
# Generate with: bun run scripts/generate-vapid-jwk.ts
# Local: Add to .dev.vars
# Production: wrangler secret put VAPID_PRIVATE_KEY
# VAPID_PRIVATE_KEY=<base64url JWK private key>

# Admin emails (comma-separated) for manual cron trigger access
# ADMIN_EMAILS=admin@example.com,admin2@example.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Production Deployment
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Set secrets via Wrangler CLI (never in .env):
#   wrangler secret put BETTER_AUTH_SECRET
#   wrangler secret put BETTER_AUTH_GOOGLE_CLIENT_ID
#   wrangler secret put BETTER_AUTH_GOOGLE_CLIENT_SECRET
#   wrangler secret put TURNSTILE_SECRET_KEY
#   wrangler secret put UNOSEND_API_KEY
#   wrangler secret put VAPID_PRIVATE_KEY
#   wrangler secret put ADMIN_EMAILS  # Optional: for manual cron trigger
